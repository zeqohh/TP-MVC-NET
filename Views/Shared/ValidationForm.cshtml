@model TPLOCAL1.Models.FormModel

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>HN - Validation</title>
    <link rel="stylesheet" href="~/resources/Index.css" />
</head>
<body>
    <header>
        <img src="~/resources/GroupeHN.png" class="image" alt="GroupeHN" />
        <h1>Récapitulatif de votre formulaire</h1>
    </header>

    <nav>
        <ul>
            <li><a href="/Home/Index">Accueil</a></li>
            <li><a href="/Home/Index/Form">Remplir le formulaire</a></li>
            <li><a href="/Home/Index/OpinionList">Liste des avis</a></li>
        </ul>
    </nav>

    <section>
        <p class="confirmation">Votre formulaire a bien été pris en compte</p>

        @* Les données ne sont qu'affichées : aucun champ modifiable ici. *@
        <table>
            <tr><th colspan="2" class="titre-tableau">Informations personnelles</th></tr>
            <tr><td>Nom</td><td>@Model.LastName</td></tr>
            <tr><td>Prénom</td><td>@Model.FirstName</td></tr>
            <tr><td>Genre</td><td>@Model.Gender</td></tr>
            <tr><td>Adresse</td><td>@Model.Address</td></tr>
            <tr><td>Code postal</td><td>@Model.PostalCode</td></tr>
            <tr><td>Ville</td><td>@Model.City</td></tr>
            <tr><td>Adresse mail</td><td>@Model.Email</td></tr>
        </table>

        <table>
            <tr><th colspan="2" class="titre-tableau">Informations sur la formation suivie</th></tr>
            <tr>
                <td>Date de début de formation</td>
                @* Format français jour/mois/année *@
                <td>@Model.TrainingStartDate?.ToString("dd/MM/yyyy")</td>
            </tr>
            <tr><td>Type de formation</td><td>@Model.TrainingType</td></tr>
        </table>

        <table>
            <tr><th colspan="2" class="titre-tableau">Avis sur la formation</th></tr>
            <tr><td>Formation Cobol</td><td>@Model.CobolOpinion</td></tr>
            <tr><td>Formation C#</td><td>@Model.CsharpOpinion</td></tr>
        </table>
    </section>
</body>
</html>